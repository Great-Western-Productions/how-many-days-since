---
import { freshResult } from '../lib/latest-result';

// Rendered per request, so the banner comes down on its own once the result
// is older than `RESULT_FRESH_DAYS`.
const result = freshResult(new Date());
---
{result && (
  <a class:list={['result-banner', result.team]} href={`/record/${result.year}/`} data-result-banner data-track-event="record_game_opened" data-track-properties={JSON.stringify({ game_year: result.year, placement: 'result_banner' })}>
    <span class="result-banner-label">FINAL · {result.longDate.toUpperCase()} · {result.location.toUpperCase()}</span>
    <strong>{result.headline}</strong>
    <span class="result-banner-more">THE {result.year} GAME →</span>
  </a>
)}

<style>
  .result-banner { display:flex; flex-wrap:wrap; align-items:baseline; justify-content:center; gap:6px 18px; padding:14px 20px; background:#111; color:#fff; text-align:center; text-decoration:none; }
  .result-banner.osu { background:#bb0000; }
  .result-banner.mich { background:#00274c; }
  .result-banner strong { font:clamp(20px,3.4vw,30px)/1.05 'Archivo Black', Arial, sans-serif; letter-spacing:-.01em; }
  .result-banner-label,.result-banner-more { font-size:12px; font-weight:700; letter-spacing:.06em; }
  .result-banner.osu .result-banner-label,.result-banner.osu .result-banner-more { color:#f1d5d5; }
  .result-banner.mich .result-banner-label,.result-banner.mich .result-banner-more { color:#ffcb05; }
  .result-banner:hover .result-banner-more,.result-banner:focus-visible .result-banner-more { text-decoration:underline; }
  @media (max-width:640px) { .result-banner { flex-direction:column; align-items:center; gap:4px; padding:12px 16px; } }
</style>
