---
import SiteShell from '../components/SiteShell.astro';
import {
  TEAM_IDS,
  TEAM_NAMES,
  cityFor,
  edgesHeld,
  formatEdge,
  formatRecord,
  historyText,
  kickoffDate,
  kickoffTime,
  marginText,
  matchups,
  monthDay,
  otherTeam,
  previewDescription,
  previewTitle,
  rankText,
  resultText,
  rivalryPreview as preview,
  tapeRecord,
  teamClass,
  twinSummary,
  type TeamId,
} from '../lib/preview';

const { tape, teams, twins, commonOpponents, coverage } = preview;
const home = preview.game.homeTeamId;
const kickoff = `${kickoffDate(preview)} · ${kickoffTime(preview)} · ${cityFor(home)}`.toUpperCase();
const through = preview.dataThrough ? monthDay(preview.dataThrough) : null;
const held = edgesHeld(tape);
const leader: TeamId | null = held['ohio-state'] === held.michigan ? null : held['ohio-state'] > held.michigan ? 'ohio-state' : 'michigan';
const past = tapeRecord(preview.pastTapes);
const upset = past.upset;
// The winner leads a past score, in its own color.
const scoreOrder = (winner: TeamId | 'tie'): TeamId[] => (winner === 'michigan' ? ['michigan', 'ohio-state'] : ['ohio-state', 'michigan']);
---

<SiteShell active="preview" title={previewTitle(preview)} description={previewDescription(preview)}>
  <section class="preview">
    <div class="section-title"><h1>THE PREVIEW</h1><span>{kickoff}</span></div>

    <section class="teams" aria-label="Records entering the game">
      {TEAM_IDS.map((teamId) => (
        <div data-team={teamId}>
          <b class={teamClass(teamId)}>{TEAM_NAMES[teamId].toUpperCase()}</b>
          <strong class={teamClass(teamId)}>{formatRecord(teams[teamId])}</strong>
          <small>{rankText(teams[teamId].apRank).toUpperCase()} · {teams[teamId].pointsPerGame?.toFixed(1)} SCORED · {teams[teamId].pointsAllowedPerGame?.toFixed(1)} ALLOWED</small>
        </div>
      ))}
    </section>

    <section aria-labelledby="tape-heading">
      <div class="section-title sub"><h2 id="tape-heading">TALE OF THE TAPE</h2><span>DERIVED · REGULAR SEASON{through ? ` THROUGH ${through.toUpperCase()}` : ''}</span></div>
      <p class="summary" data-testid="tape-summary">
        {leader
          ? <><b class={teamClass(leader)}>{TEAM_NAMES[leader]}</b> holds {held[leader]} of the {tape.length} edges.</>
          : <>The {tape.length} edges split evenly.</>}
        {' '}The team holding more edges has won {past.won} of {past.of} since {coverage.stats.since}.
        {upset && <>{' '}In {upset.season}, {TEAM_NAMES[otherTeam(upset.winner)]} held {upset.edges[otherTeam(upset.winner)]} and {TEAM_NAMES[upset.winner]} won.</>}
      </p>
      <div class="tape">
        <div class="tape-teams" aria-hidden="true"><b class="osu">OHIO STATE</b><b class="mich">MICHIGAN</b></div>
        {tape.map((band) => (
          <article class="band" data-band={band.id}>
            <header><h3>{band.label.toUpperCase()}</h3><span>{band.unit.toUpperCase()}</span></header>
            {matchups(band).map((row) => (
              <div class="band-row">
                <strong>{row.ohioState}</strong>
                <span>{row.label}</span>
                <strong>{row.michigan}</strong>
              </div>
            ))}
            <footer>
              <b class={band.edge ? teamClass(band.edge.teamId) : undefined} data-edge>EDGE: {formatEdge(band).toUpperCase()}</b>
              <span data-history>EDGE HOLDER WON {band.history.map(historyText).join(' · ').toUpperCase()}</span>
            </footer>
          </article>
        ))}
        <article class="band" data-band="home-field">
          <header><h3>HOME FIELD</h3><span>{cityFor(home).toUpperCase()}</span></header>
          <footer>
            <b class={teamClass(home)} data-edge>EDGE: {TEAM_NAMES[home].toUpperCase()}</b>
            <span data-history>HOME TEAM WON {preview.home.map(historyText).join(' · ').toUpperCase()}</span>
          </footer>
        </article>
      </div>
    </section>

    <section aria-labelledby="twins-heading">
      <div class="section-title sub"><h2 id="twins-heading">THE CLOSEST MEETINGS</h2><span>BY RECORD, SCORING AND SITE ENTERING THE GAME · SINCE {coverage.scores.since}</span></div>
      <p class="summary" data-testid="twins-summary">{twinSummary(twins)}</p>
      <div class="twins">
        {twins.map((twin) => (
          <a class="twin" href={`/record/${twin.season}/`} data-track-event="record_game_opened" data-track-properties={JSON.stringify({ game_year: twin.season })}>
            <strong>{twin.season}</strong>
            <small>OHIO STATE {formatRecord(twin.records['ohio-state'])} · MICHIGAN {formatRecord(twin.records.michigan)} · {cityFor(twin.homeTeamId).toUpperCase()}</small>
            <b>{scoreOrder(twin.winner).map((teamId, index) => <>{index > 0 && ', '}<span class={teamClass(teamId)}>{TEAM_NAMES[teamId]} {twin.score[teamId]}</span></>)}</b>
          </a>
        ))}
      </div>
    </section>

    {commonOpponents.rows.length > 0 && (
      <section aria-labelledby="common-heading">
        <div class="section-title sub"><h2 id="common-heading">COMMON OPPONENTS</h2><span>BETTER AVERAGE MARGIN WON {commonOpponents.history.map(historyText).join(' · ').toUpperCase()}</span></div>
        <div class="common-wrap">
          <table class="common">
            <thead><tr><th scope="col">OPPONENT</th><th scope="col" class="osu">OHIO STATE</th><th scope="col" class="mich">MICHIGAN</th></tr></thead>
            <tbody>
              {commonOpponents.rows.map((row) => (
                <tr>
                  <th scope="row">{row.opponent}</th>
                  {TEAM_IDS.map((teamId) => <td>{resultText(row[teamId])} <small>{row[teamId].site.toUpperCase()}</small></td>)}
                </tr>
              ))}
              <tr class="average">
                <th scope="row">Average margin</th>
                {TEAM_IDS.map((teamId) => <td class={commonOpponents.edge === teamId ? teamClass(teamId) : undefined}>{marginText(commonOpponents.averageMargin[teamId])}</td>)}
              </tr>
            </tbody>
          </table>
        </div>
      </section>
    )}

    <p class="method">
      Each number counts regular-season games played before kickoff{through ? `, through ${through}` : ''}. The count beside an edge compares the two teams' numbers entering that year's game, so a count never includes the game it grades. Box-score history starts in {coverage.stats.since} ({coverage.stats.meetings} meetings) and scores in {coverage.scores.since} ({coverage.scores.meetings} meetings with a winner). A red zone trip is a drive that reached the opponent 20 or scored a touchdown. Data: CollegeFootballData.com.
    </p>
  </section>
  <script>
    import { trackMarkedLinks } from '../lib/client/analytics';

    trackMarkedLinks();
  </script>
</SiteShell>

<style>
  .preview h1 { margin:0; font:48px 'Archivo Black'; letter-spacing:-.02em; }
  .preview h2 { margin:0; font:24px 'Archivo Black'; letter-spacing:-.02em; }
  .section-title.sub { margin-top:48px; }
  .summary { max-width:720px; margin:10px 0 0; color:#3d4148; font-size:16px; line-height:1.55; }

  .teams { display:grid; grid-template-columns:1fr 1fr; margin-top:24px; border:3px solid #111; }
  .teams div { padding:20px; text-align:center; }
  .teams div + div { border-left:1px solid #d9dce1; }
  .teams b { display:block; font-size:12px; letter-spacing:.08em; }
  .teams strong { display:block; margin:6px 0; font:56px/1 'Archivo Black'; }
  .teams small { color:#6b717c; font-size:11px; font-weight:700; letter-spacing:.06em; }

  .tape { margin-top:20px; border:3px solid #111; }
  .tape-teams { position:sticky; top:0; z-index:1; display:flex; justify-content:space-between; padding:10px 20px; border-bottom:2px solid #111; background:#fff; font-size:12px; letter-spacing:.08em; }
  .band { padding:16px 20px 14px; }
  .band + .band { border-top:2px solid #111; }
  .band header { display:flex; align-items:baseline; gap:10px; flex-wrap:wrap; }
  .band h3 { margin:0; font:18px 'Archivo Black'; letter-spacing:-.01em; }
  .band header span { color:#6b717c; font-size:11px; font-weight:700; letter-spacing:.08em; }
  .band-row { display:grid; grid-template-columns:1fr minmax(0, 1.4fr) 1fr; align-items:center; gap:12px; padding:9px 0; border-bottom:1px solid #e6e8ec; }
  .band-row strong { font-size:17px; }
  .band-row strong:last-child { text-align:right; }
  .band-row span { color:#6b717c; font-size:11px; font-weight:700; letter-spacing:.04em; text-align:center; text-transform:uppercase; }
  .band footer { display:flex; justify-content:space-between; align-items:baseline; gap:6px 16px; flex-wrap:wrap; margin-top:10px; font-size:12px; letter-spacing:.04em; }
  .band footer span { color:#3d4148; font-weight:700; }

  .twins { display:grid; grid-template-columns:repeat(3, 1fr); gap:14px; margin-top:20px; }
  .twin { display:block; padding:16px 18px; border:1px solid #111; border-top:4px solid #111; color:inherit; text-decoration:none; }
  .twin strong { display:block; font:34px/1 'Archivo Black'; }
  .twin small { display:block; margin:8px 0; color:#6b717c; font-size:11px; font-weight:700; letter-spacing:.04em; line-height:1.4; }
  .twin b { font-size:15px; }
  .twin:hover strong, .twin:focus-visible strong { text-decoration:underline 3px #bb0000; text-underline-offset:5px; }

  .common-wrap { overflow-x:auto; margin-top:20px; border:3px solid #111; }
  .common { width:100%; border-collapse:collapse; }
  .common th, .common td { padding:12px 14px; border-bottom:1px solid #d9dce1; text-align:left; font-size:14px; }
  .common thead th { background:#f2f3f5; font-size:11px; letter-spacing:.04em; }
  .common td { font-weight:700; }
  .common td small { margin-left:4px; color:#6b717c; font-size:10px; letter-spacing:.06em; }
  .common tbody tr:last-child > * { border-bottom:0; }
  .common .average > * { border-top:2px solid #111; }

  .method { max-width:720px; margin:40px 0 0; padding-top:14px; border-top:2px solid #111; color:#3d4148; font-size:13px; line-height:1.55; }

  @media (max-width:700px) {
    .preview h1 { font-size:36px; }
    .teams strong { font-size:40px; }
    .band { padding:14px 12px 12px; }
    .tape-teams { padding:10px 12px; }
    .band-row { grid-template-columns:1fr 1fr; }
    .band-row span { grid-column:1 / -1; grid-row:1; text-align:left; }
    .band-row strong { font-size:15px; }
    .twins { grid-template-columns:1fr; }
  }
</style>
