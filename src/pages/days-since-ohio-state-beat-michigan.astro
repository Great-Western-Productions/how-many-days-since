---
import CountStatement from '../components/CountStatement.astro';
import SiteShell from '../components/SiteShell.astro';
import games from '../data/rivalry-games.json';
import { countStatement } from '../lib/count-statement';
import { calcDaysSince } from '../lib/days';
import { formatCount, formatDayCount } from '../lib/share-graphic';
import { nextGameDateLabel, nextRivalryGame } from '../lib/next-rivalry-game';
import { earliestGame, lastOhioStateWin, latestGame } from '../lib/rivalry-anchors';

// The Ohio State side of the question on a page of its own. The home page
// answers it too, but Google ranks that page for the Michigan phrasing its
// domain and headline carry, so this one leads with the Ohio State wording.
// The anchor comes out of the record, so no date lives in this template.
const now = new Date();
const days = calcDaysSince(lastOhioStateWin.kickoff, now);
const newest = latestGame();
const oldest = earliestGame();
const totals = games.reduce((value, game) => ({ michigan: value.michigan + Number(game.winner === 'Michigan'), ohioState: value.ohioState + Number(game.winner === 'Ohio State'), ties: value.ties + Number(game.winner === 'Tie') }), { michigan: 0, ohioState: 0, ties: 0 });
const since2012 = games.filter((game) => game.year >= 2012).reduce((value, game) => ({ michigan: value.michigan + Number(game.winner === 'Michigan'), ohioState: value.ohioState + Number(game.winner === 'Ohio State') }), { michigan: 0, ohioState: 0 });
const date = new Intl.DateTimeFormat('en-US', { timeZone: 'America/New_York', weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' }).format(now);
const dayWord = (count: number) => (count === 1 ? 'day' : 'days');

const title = 'How Many Days Since Ohio State Beat Michigan?';
const description = `${formatCount(days)} ${dayWord(days)} since Ohio State beat Michigan. OSU last won ${lastOhioStateWin.score} in ${lastOhioStateWin.location} on ${lastOhioStateWin.longDate}. Next meeting: ${nextGameDateLabel(nextRivalryGame)} in ${nextRivalryGame.location}.`;
// The statement printed under the counter: the count, today's date, the last win and the method.
const countAnswer = countStatement(lastOhioStateWin, days, date);
// The statement sits under the counter, so the OSU phrasing gets the short form.
const osuAnswer = `${formatDayCount(days)}, as of ${date}. The count starts from Ohio State's ${lastOhioStateWin.score} win in ${lastOhioStateWin.location} on ${lastOhioStateWin.longDate}.`;
const lastWinAnswer = `Ohio State last beat Michigan on ${lastOhioStateWin.longDate}, winning ${lastOhioStateWin.score} in ${lastOhioStateWin.location}.`;
// Server-rendered per request, so the answers match the counter on every visit.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'How many days since Ohio State beat Michigan?', acceptedAnswer: { '@type': 'Answer', text: countAnswer } },
    { '@type': 'Question', name: 'How many days since OSU beat Michigan?', acceptedAnswer: { '@type': 'Answer', text: countAnswer } },
    { '@type': 'Question', name: 'When did Ohio State last beat Michigan?', acceptedAnswer: { '@type': 'Answer', text: lastWinAnswer } },
  ],
};
// The host city wears the host's color in the next-game line.
const hostClass = nextRivalryGame.homeTeam.name.startsWith('Ohio State') ? 'osu' : 'mich';
---
<SiteShell title={title} description={description} schema={faqSchema}>
  <section class="count" data-osu-count data-reference-date={lastOhioStateWin.iso}><h1>HOW MANY DAYS SINCE <span class="osu">OHIO STATE</span> BEAT <span class="mich">MICHIGAN</span>?</h1><p class="date" data-current-date>{date}</p><p class="counter" aria-live="polite"><strong id="osu_days_count">{formatCount(days)}</strong> <span>DAYS</span></p><CountStatement win={lastOhioStateWin} now={now} today={date} /><p class="last">Last <b class="osu">Ohio State</b> win: {lastOhioStateWin.longDate} - {lastOhioStateWin.score}, {lastOhioStateWin.location}.<br /><a class="next-game-link" href="/countdown/"><b>NEXT GAME:</b> {nextGameDateLabel(nextRivalryGame)} - <span class={hostClass}>{nextRivalryGame.location}</span>.</a></p></section>
  <section class="stat-box"><div><strong class={newest.winner === 'Ohio State' ? 'osu' : newest.winner === 'Michigan' ? 'mich' : undefined}>{newest.winner === 'Ohio State' ? 'OSU' : newest.winner === 'Michigan' ? 'MICH' : 'TIE'} {newest.wScore}-{newest.lScore}</strong><small>THE GAME, {newest.year} · {newest.location?.toUpperCase()}</small></div><div><strong class="osu">{since2012.ohioState}-{since2012.michigan}</strong><small>OSU VS MICHIGAN SINCE 2012</small></div><div><strong>{totals.ohioState}-{totals.michigan}-{totals.ties}</strong><small>ALL-TIME SERIES (OSU-M-T), {oldest.year}-{newest.year}</small></div></section>
  <section class="osu-faq">
    <h2>How many days since OSU beat Michigan?</h2>
    <p>{osuAnswer}</p>
    <h2>When did Ohio State last beat Michigan?</h2>
    <p>{lastWinAnswer}</p>
    <p class="osu-faq-other">Counting the other way? See the <a href="/">days since Michigan beat Ohio State</a>.</p>
  </section>
</SiteShell>

<script>
  import { calcDaysSince } from '../lib/days';
  import { formatCount } from '../lib/share-graphic';

  const osuCount = document.querySelector<HTMLElement>('[data-osu-count]');
  const referenceDate = new Date(osuCount?.dataset.referenceDate ?? '');
  const count = document.getElementById('osu_days_count');
  const currentDate = document.querySelector<HTMLElement>('[data-current-date]');
  const renderCurrentTime = () => {
    const now = new Date();
    if (count) count.textContent = formatCount(calcDaysSince(referenceDate, now));
    if (currentDate) currentDate.textContent = new Intl.DateTimeFormat('en-US', { timeZone: 'America/New_York', weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' }).format(now);
  };
  renderCurrentTime();
  setInterval(renderCurrentTime, 60_000);
</script>

<style>
  .count h1 { font-size: 42.5px; }
  .next-game-link { color:inherit; text-decoration:none; }
  .next-game-link:hover .osu,.next-game-link:focus-visible .osu { background:#bb0000; color:#d9dce1; }
  .next-game-link:hover .mich,.next-game-link:focus-visible .mich { background:#00274c; color:#ffcb05; }
  .osu-faq { max-width:640px; margin:40px auto 0; }
  .osu-faq h2 { margin:28px 0 8px; font:20px 'Archivo Black'; letter-spacing:.01em; }
  .osu-faq p { margin:0; color:#3d4148; font-size:16px; line-height:1.55; }
  .osu-faq .osu-faq-other { margin-top:28px; padding-top:16px; border-top:3px solid #111; }
  .osu-faq a { color:#00274c; font-weight:700; }
  @media (max-width:640px) { .count h1 { font-size:30px; } }
</style>
